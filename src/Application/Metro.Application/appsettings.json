{
  "PostgreSQL": {
    "Connection": ""
  },
  "Email": {
    "Email": "",
    "Host": "",
    "Port": "587",
    "User": "",
    "Pass": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "JWT": {
      "Issuer": "metro-core",
      "Audience": "metro-core-api",
      "AccessTokenExpiresInMinutes": 60,
      "RefreshTokenExpiresInDays": 7,
      "Key": ""
    }
  },
  "RateLimit": {
    "CreateUser": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    },
    "Login": {
      "PermitLimit": 10,
      "WindowMinutes": 15
    },
    "PasswordRecovery": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    }
  },
  "PasswordRecovery": {
    "CodeLength": 6,
    "CodeExpiresInMinutes": 30,
    "MaxAttempts": 5
  },
  "Storage": {
    "RootPath": "Public/Storage",
    "RequestPath": "/Storage"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:4200",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:4200"
    ]
  },
  "AllowedHosts": "*",
  "DeveloperEnvironments": "true"
}
